# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=True
PORT=5000

# RAG Configuration
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHUNK_SIZE=500
CHUNK_OVERLAP=100
TOP_K=5
SIMILARITY_THRESHOLD=0.25

# LLM Provider Configuration (Optional)
# Leave blank to use the built-in grounded synthesis fallback
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
LLM_PROVIDER=none
